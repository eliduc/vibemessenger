# ═══════════════════════════════════════════════════════════════════════════════
# VibeMessenger v3.2 — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env
# ═══════════════════════════════════════════════════════════════════════════════

# ======================
# DATABASE (Required)
# ======================
# PostgreSQL password. Generate a strong random password:
#   openssl rand -base64 24
DB_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_24

# ======================
# SECURITY (Required - CRITICAL!)
# ======================
# JWT signing key. MUST be at least 32 characters!
# Application will REFUSE to start with an insecure key.
# Generate with:
#   openssl rand -hex 32
# Note: In docker-compose.yml this is mapped to MESSENGER_SECRET_KEY
SECRET_KEY=CHANGE_ME_generate_64_char_hex_with_openssl_rand_hex_32

# ======================
# VAPID (Required for Push Notifications)
# ======================
# Web Push (VAPID) public key for browser push notifications.
# Generate both keys with:
#   ./generate-keys.sh
# The script will output the public key to paste here.
MESSENGER_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE

# ======================
# TURN SERVER (Required for WebRTC Calls behind NAT)
# ======================
# Without TURN server, calls only work on local network.
# Get FREE credentials at: https://www.metered.ca/stun-turn
#
# Set to false to disable TURN (calls may not work behind NAT)
MESSENGER_TURN_ENABLED=true
MESSENGER_TURN_SERVER_URL=global.relay.metered.ca
MESSENGER_TURN_SERVER_PORT=443
MESSENGER_TURN_USERNAME=your_metered_username
MESSENGER_TURN_CREDENTIAL=your_metered_credential
MESSENGER_STUN_SERVER_URL=stun:stun.relay.metered.ca:80

# ======================
# BACKUP (Optional)
# ======================
# Directory for database backups (usually USB drive)
# Make sure it's mounted and writable!
BACKUP_DIR=/mnt/backup

# ======================
# CORS (Optional - for development only)
# ======================
# Comma-separated list of allowed origins.
# Leave empty for same-origin only (recommended for production).
# Example: https://myapp.example.com,https://localhost:3000
MESSENGER_CORS_ORIGINS=

# ======================
# DEBUG (Development only!)
# ======================
# NEVER enable in production - exposes sensitive info!
MESSENGER_DEBUG=false

# ======================
# DO NOT CHANGE (Internal settings)
# ======================
MESSENGER_HOST=0.0.0.0
MESSENGER_PORT=8000
