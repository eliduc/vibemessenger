events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    
    # Hide nginx version
    server_tokens off;

    upstream messenger {
        server messenger:8000;
    }

    # ==========================================
    # RATE LIMITING ZONES
    # ==========================================
    
    # Zone for login/register - strict: 5 requests per minute per IP
    # Prevents brute-force password attacks
    limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/m;
    
    # Zone for file uploads - moderate: 10 requests per minute per IP
    # Prevents storage exhaustion attacks
    limit_req_zone $binary_remote_addr zone=upload_limit:10m rate=10r/m;
    
    # Zone for general API - relaxed: 60 requests per minute per IP
    # Prevents general API abuse
    limit_req_zone $binary_remote_addr zone=api_limit:10m rate=60r/m;
    
    # Custom error page for rate limiting
    limit_req_status 429;

    # Redirect HTTP to HTTPS
    server {
        listen 80;
        server_name _;
        return 301 https://$host$request_uri;
    }

    # HTTPS server
    server {
        listen 443 ssl;
        server_name _;

        ssl_certificate /etc/nginx/certs/server.crt;
        ssl_certificate_key /etc/nginx/certs/server.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
        ssl_prefer_server_ciphers off;
        
        # ==========================================
        # SECURITY HEADERS
        # ==========================================
        
        # Prevent clickjacking
        add_header X-Frame-Options "SAMEORIGIN" always;
        
        # Prevent MIME type sniffing
        add_header X-Content-Type-Options "nosniff" always;
        
        # XSS protection (legacy, but still useful)
        add_header X-XSS-Protection "1; mode=block" always;
        
        # Control referrer information
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        
        # HTTP Strict Transport Security (1 year, include subdomains)
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        
        # Content Security Policy
        # Note: 'unsafe-inline' needed for onclick handlers in HTML
        # Consider migrating to event listeners to remove this
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' wss: https:; media-src 'self' blob: data:; font-src 'self'; frame-ancestors 'self';" always;
        
        # Permissions Policy (formerly Feature-Policy)
        add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=()" always;
        
        # Limit request body size (file uploads) - 20MB max to prevent DoS
        client_max_body_size 20M;
        
        # Block access to hidden files (dotfiles)
        location ~ /\. {
            deny all;
            return 404;
        }

        # Static files (web client)
        location / {
            root /usr/share/nginx/html;
            index index.html;
            try_files $uri $uri/ /index.html;
        }

        # ==========================================
        # RATE-LIMITED AUTH ENDPOINTS
        # ==========================================
        
        # Login endpoint - strict rate limit
        location = /api/v1/auth/login {
            limit_req zone=auth_limit burst=3 nodelay;
            
            proxy_pass http://messenger;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
        
        # Register endpoint - strict rate limit
        location = /api/v1/auth/register {
            limit_req zone=auth_limit burst=2 nodelay;
            
            proxy_pass http://messenger;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
        
        # Token refresh - moderate rate limit
        location = /api/v1/auth/refresh {
            limit_req zone=auth_limit burst=5 nodelay;
            
            proxy_pass http://messenger;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # ==========================================
        # RATE-LIMITED FILE UPLOADS
        # ==========================================
        
        # File upload endpoint
        location = /api/v1/files/upload {
            limit_req zone=upload_limit burst=5 nodelay;
            
            proxy_pass http://messenger;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            
            # Increase timeout for large uploads
            proxy_read_timeout 300;
            proxy_send_timeout 300;
        }
        
        # Avatar upload
        location = /api/v1/auth/avatar {
            limit_req zone=upload_limit burst=3 nodelay;
            
            proxy_pass http://messenger;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
        
        # Group avatar upload (regex to match group_id)
        location ~ ^/api/v1/groups/[a-f0-9-]+/avatar$ {
            limit_req zone=upload_limit burst=3 nodelay;
            
            proxy_pass http://messenger;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # ==========================================
        # GENERAL API (with moderate rate limit)
        # ==========================================
        
        location /api/ {
            limit_req zone=api_limit burst=20 nodelay;
            
            proxy_pass http://messenger;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # ==========================================
        # WEBSOCKET (no rate limit - persistent connection)
        # ==========================================
        
        location /ws {
            # Disable access logging to prevent token leakage
            access_log off;
            
            proxy_pass http://messenger;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 86400;
        }

        # Health check (no rate limit)
        location /health {
            proxy_pass http://messenger;
        }
        
        # Custom error page for rate limiting
        error_page 429 @rate_limited;
        location @rate_limited {
            default_type application/json;
            return 429 '{"detail": "Too many requests. Please try again later."}';
        }
    }
}
